<?xml version="1.0"?>
<robot name="simple_cylinder">
  <link name="cylinder_link">
    <visual>
      <geometry>
        <cylinder radius="0.07" length="0.2"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.07" length="0.2"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001"/>
    </inertial>
  </link>
</robot>
